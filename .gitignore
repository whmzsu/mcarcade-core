# ============================================================
# 构建产物与缓存 —— 全部可由 zig build 重新生成
# ============================================================
.zig-cache/
zig-out/
build/
out/
# CI 里 PXTBUILD 指向仓库内的这个目录（actions/cache 缓存的 npm 环境）
.pxtbuild/
*.o
*.obj
*.pdb
*.ilk

# ============================================================
# 发布二进制 —— 走 GitHub Releases，不进 git 历史
# 只保留 .info（小文本，方便直接拷进 RetroArch cores 目录）
# ============================================================
dist/*
!dist/arcade_libretro.info

# ============================================================
# third_party 里不参与构建的部分
#   pxt-src/     pxt 的 TS 参考源码，2.9MB，"仅参考"，删了不影响编译
#   embed_probe 自己编的 qjsrun.exe 与 pdb
# ============================================================
third_party/pxt-src/
tools/dev/embed_probe/bin/

# ============================================================
# 杂项
#   nul 是 Windows 上 `>nul` 误重定向产生的 PE 文件
# ============================================================
nul
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/
node_modules/
__pycache__/
