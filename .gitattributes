# 默认按文本处理，入库统一 LF（Windows 上 checkout 也是 LF，避免 zig cc 报错）
* text=auto eol=lf

# third_party 是"原样入库"的上游源码，禁止 git 转换行尾
third_party/** -text

# 二进制
*.png binary
*.jpg binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.zip binary
*.a binary
*.lib binary
*.pdb binary

# 生成的载荷头体积巨大，diff 没意义
build/gen/** linguist-generated=true
